# HYDROFLEX AI API — persistent Python backend (the HiGHS solver cannot run on static hosting).
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY pyproject.toml README.md ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY data ./data
COPY docs ./docs
COPY results/experiments ./results/experiments
COPY research/paper ./research/paper
RUN pip install --no-cache-dir -e .
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/api/health')"
CMD ["uvicorn", "hydroflex_api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
