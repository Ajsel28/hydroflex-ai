# HYDROFLEX AI API — persistent Python backend (the HiGHS solver cannot run on static hosting).
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8000
COPY pyproject.toml README.md ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY data ./data
COPY docs ./docs
COPY results/experiments ./results/experiments
COPY research/paper ./research/paper
RUN pip install --no-cache-dir -e .
EXPOSE 8000
# Render (and most PaaS hosts) inject $PORT; default 8000 for local `docker run -p 8000:8000`.
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import os,urllib.request;urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8000')+'/api/health')"
CMD ["sh", "-c", "exec uvicorn hydroflex_api.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
